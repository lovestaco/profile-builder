{
  "manifest_version": 3,
  "name": "Profile Builder",
  "version": "1.0.1",
  "description": "Automate launch-platform actions. Peerlist: auto-upvote launches and export results as CSV.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://peerlist.io/*",
    "https://www.linkedin.com/*",
    "https://www.f6s.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Profile Builder"
  },
  "content_scripts": [
    {
      "matches": [
        "https://peerlist.io/*"
      ],
      "js": [
        "content/peerlist.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
